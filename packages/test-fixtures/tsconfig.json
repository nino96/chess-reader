{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tsbuild",
    "tsBuildInfoFile": "./node_modules/.tsbuild/tsconfig.tsbuildinfo",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true
  },
  "include": ["src/**/*.ts", "generators/**/*.mjs", "tests/**/*.ts", "vitest.config.ts"]
}
