{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@playwright/test": ["../../../../apps/web/node_modules/@playwright/test/index.d.ts"],
      "vitest": ["../../../../apps/web/node_modules/vitest/dist/index.d.ts"],
      "vite": ["../../../../apps/web/node_modules/vite/dist/node/index.d.ts"],
      "onnxruntime-web/wasm": ["../../../../apps/web/node_modules/onnxruntime-web/types.d.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "incremental": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["*.ts", "../../browser/main.ts", "../../browser/assets.d.ts"]
}
