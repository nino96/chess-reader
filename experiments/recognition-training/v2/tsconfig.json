{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "../node_modules/.tsbuild/training/v2",
    "paths": {
      "@napi-rs/canvas": ["../../../packages/test-fixtures/node_modules/@napi-rs/canvas"],
      "@scoriiu/fenshot": ["../../../packages/test-fixtures/node_modules/@scoriiu/fenshot"],
      "@playwright/test": ["../../../apps/web/node_modules/@playwright/test"],
      "playwright": ["../../../node_modules/.pnpm/node_modules/playwright"]
    },
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "*.mjs",
    "scripts/**/*.mjs",
    "tests/**/*.mjs",
    "*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "references": [
    {
      "path": "../"
    }
  ]
}
