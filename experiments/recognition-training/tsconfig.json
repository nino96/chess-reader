{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "node_modules/.tsbuild/training",
    "paths": {
      "@napi-rs/canvas": ["../../packages/test-fixtures/node_modules/@napi-rs/canvas"],
      "@scoriiu/fenshot": ["../../packages/test-fixtures/node_modules/@scoriiu/fenshot"]
    },
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "*.mjs",
    "scripts/**/*.mjs",
    "tests/**/*.mjs",
    "*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
