{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tsbuild/node",
    "tsBuildInfoFile": "./node_modules/.tsbuild/node.tsbuildinfo",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mjs",
    "src/app/icons.test.ts"
  ]
}
