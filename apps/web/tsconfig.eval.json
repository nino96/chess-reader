{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": "../..",
    "outDir": "./node_modules/.tsbuild/eval",
    "tsBuildInfoFile": "./node_modules/.tsbuild/eval.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": [
    "eval/corpus*.ts",
    "eval/report.ts",
    "src/recognition/assets.ts",
    "../../packages/test-fixtures/src/corpus.ts",
    "../../packages/test-fixtures/src/corpus-metrics.ts"
  ]
}
